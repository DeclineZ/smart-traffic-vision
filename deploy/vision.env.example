# /etc/traffic-vision/vision.env (chmod 600, owner traffic)
VISION_MODEL=models/yolo26s_thai_traffic.engine
# sha256 of the deployed engine (see models/<name>.engine.json written by export_trt.py)
VISION_MODEL_SHA256=
VISION_INTERSECTION_ID=INT-001
VISION_SOURCE_ID=VISION-INT-001
# Live sources only; stop the existing INT-001 mock producer when cutting over.
# Use shadow while evaluating alongside another live producer.
VISION_OUTPUT_MODE=controller
VISION_CONTROLLER_CONFIG=config/controller_main.json
# Match the existing broker listener. TLS is optional if that listener supports it.
MQTT_URL=mqtt://controller-host:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# For a configured TLS listener: MQTT_URL=mqtts://broker.internal:8883
# MQTT_TLS_CA=/etc/traffic-vision/mqtt-ca.pem
