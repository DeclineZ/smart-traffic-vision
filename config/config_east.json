{
  "_comment": "=== East Soi Approach (CAM_03) Configuration ===",
  "camera_info": {
    "camera_id": "CAM-03",
    "location": "East Soi Entrance",
    "intersection_id": "INT-001",
    "description": "Incoming soi traffic approaching intersection from East"
  },
  "video": {
    "path": "./videos/cam03_east.avi",
    "skip": 0,
    "max_frames": 0
  },
  "model": {
    "engine_path": "models/yolov7-tiny.engine",
    "input_shape": [1, 3, 640, 640],
    "device": "cuda:0"
  },
  "tracker": {
    "type": "ByteTrack",
    "params": {
      "min_conf": 0.3,
      "track_thresh": 0.5,
      "match_thresh": 0.7,
      "track_buffer": 25,
      "frame_rate": 25
