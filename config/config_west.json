      "1": "bicycle",
      "2": "car",
      "3": "motorcycle",
      "5": "bus",
      "7": "truck"
    }
  },
  "output": {
    "base_dir": "./output/west_approach",
    "save_crop": false,
    "data_output_path": "output/west_approach/data.json"
