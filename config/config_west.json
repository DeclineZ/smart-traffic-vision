{
  "_comment": "=== West Soi Approach (CAM_46) Configuration ===",
  "camera_info": {
    "camera_id": "CAM-04",
    "location": "West Soi Entrance",
    "intersection_id": "INT-001",
    "description": "Incoming soi traffic approaching intersection from West"
  },
  "video": {
    "path": "./videos/cam46_west.avi",
    "skip": 0,
    "max_frames": 0
  },
  "model": {
    "engine_path": "models/yolov7-tiny.engine",
    "input_shape": [1, 3, 640, 640],
