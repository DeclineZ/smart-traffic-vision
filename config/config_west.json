  "tracking": {
    "zones": [
      {
        "name": "west_soi_lane",
        "lane": "[(100, 200), (1200, 200), (1100, 1070), (50, 1070)]",
        "line": "[(80, 600), (1150, 600)]",
        "desc": "West Soi inbound flow"
      }
    ]
  },
  "lane_metrics": {
    "enabled": true,
    "publish_interval_frames": 50,
    "queue_speed_threshold": 2.0,
