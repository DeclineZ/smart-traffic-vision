        "description": "West Lane 1 (Inbound Approach 1)",
        "polygon": [[1229, 50], [5, 590], [75, 955], [1303, 67]]
      },
      "W2": {
        "direction": "W",
        "description": "West Lane 2 (Inbound Approach 2)",
        "polygon": [[1301, 67], [1381, 79], [954, 1072], [293, 1035]]
      }
    }
  },
  "density": {
    "enabled": false
  },
  "mqtt": {
    "enabled": true,
    "broker_url": "mqtt://localhost:1883",
    "topic": "traffic/counts",
    "username": "",
    "password": "",
    "qos": 1,
    "keepalive": 60
  },
  "processing": {
    "opencv_threads": 0,
    "use_opencl": false,
    "video_queue_size": 2
